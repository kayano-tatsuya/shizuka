{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "format": "{#1}╭───────────── {#}{user-name-colored}"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}System Information"
    },
    {
      "type": "os",
      "key": "{#separator}│  {#keys}󰍹 OS"
    },
    {
      "type": "host",
      "key": "{#separator}│  {#keys}󰌢 Host"
    },
    {
      "type": "kernel",
      "key": "{#separator}│  {#keys}󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "{#separator}│  {#keys}󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "{#separator}│  {#keys}󰏖 Packages",
      "format": "{all}"
    },
    {
      "type": "shell",
      "key": "{#separator}│  {#keys}󰞷 Shell"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}Desktop Environment"
    },
    {
      "type": "de",
      "key": "{#separator}│  {#keys}󰧨 DE"
    },
    {
      "type": "custom",
      "key": "{#separator}│  {#keys}󱡓 Configuration",
      "format": "shizuka (静か)"
    },
    {
      "type": "wm",
      "key": "{#separator}│  {#keys}󱂬 WM"
    },
    {
      "type": "wmtheme",
      "key": "{#separator}│  {#keys}󰉼 Theme"
    },
    {
      "type": "display",
      "key": "{#separator}│  {#keys}󰹑 Resolution"
    },
    {
      "type": "theme",
      "key": "{#separator}│  {#keys}󰉼 Theme"
    },
    {
      "type": "icons",
      "key": "{#separator}│  {#keys}󰀻 Icons"
    },
    {
      "type": "font",
      "key": "{#separator}│  {#keys}󰛖 Font"
    },
    {
      "type": "cursor",
      "key": "{#separator}│  {#keys}󰆽 Cursor"
    },
    {
      "type": "terminal",
      "key": "{#separator}│  {#keys}󰆍 Terminal"
    },
    {
      "type": "terminalfont",
      "key": "{#separator}│  {#keys}󰛖 Terminal Font"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}Hardware Information"
    },
    {
      "type": "cpu",
      "key": "{#separator}│  {#keys}󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "{#separator}│  {#keys}󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "{#separator}│  {#keys}󰍛 Memory"
    },
    {
      "type": "swap",
      "key": "{#separator}│  {#keys}󰯍 Swap"
    },
    {
      "type": "disk",
      "key": "{#separator}│  {#keys}󰋊 Disk (/)",
      "folders": "/"
    },
    {
      "type": "localip",
      "key": "{#separator}│  {#keys}󰩟 Local IP"
    },
    {
      "type": "battery",
      "key": "{#separator}│  {#keys}󰁹 Battery"
    },
    {
      "type": "poweradapter",
      "key": "{#separator}│  {#keys}󰂄 Power Adapter"
    },
    {
      "type": "locale",
      "key": "{#separator}│  {#keys}󰗊 Locale"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "custom",
      "format": "{#1}│ `shizuka` to open the shell"
    },
    {
      "type": "custom",
      "format": "{#1}│ `wallpapers` to switch wallpaper"
    },
    {
      "type": "colors",
      "key": "{#separator}│",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "{#1}╰───────────────────────────────╯"
    }
  ]
}
